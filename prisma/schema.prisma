generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(LAUNDRY)
  createdAt    DateTime @default(now())
}

model LinenType {
  id           String             @id @default(uuid())
  name         String             @unique
  unit         String
  createdAt    DateTime           @default(now())
  batches      Batch[]
  circulations LinenCirculation[]
  ticketItems  TicketItem[]

  @@map("Loại đồ vải")
}

model Batch {
  id                String             @id @default(uuid())
  code              String
  linenTypeId       String
  totalQuantity     Int
  remainingQuantity Int
  importedAt        DateTime
  createdAt         DateTime           @default(now())
  linenType         LinenType          @relation(fields: [linenTypeId], references: [id])
  circulations      LinenCirculation[]
}

model LinenCirculation {
  id                String            @id @default(uuid())
  batchId           String
  linenTypeId       String
  startUseDate      DateTime
  originalQuantity  Int
  activeQuantity    Int
  discardedQuantity Int               @default(0)
  createdAt         DateTime          @default(now())
  batch             Batch             @relation(fields: [batchId], references: [id])
  linenType         LinenType         @relation(fields: [linenTypeId], references: [id])
  discardLogs       LinenDiscardLog[]
}

model LinenDiscardLog {
  id                 String           @id @default(uuid())
  linenCirculationId String
  quantity           Int
  reason             String?
  loggedAt           DateTime         @default(now())
  circulation        LinenCirculation @relation(fields: [linenCirculationId], references: [id])
}

model Ward {
  id        String   @id @default(uuid())
  name      String   @unique
  qrToken   String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]

  @@map("Khoa")
}

model Ticket {
  id            String       @id @default(uuid())
  wardId        String
  status        TicketStatus @default(PENDING)
  requesterName String
  deliveryDate  DateTime
  createdAt     DateTime     @default(now())
  ward          Ward         @relation(fields: [wardId], references: [id])
  items         TicketItem[]
}

model TicketItem {
  id          String    @id @default(uuid())
  ticketId    String
  linenTypeId String
  quantity    Int
  linenType   LinenType @relation(fields: [linenTypeId], references: [id])
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Staff {
  id_nhanvien String   @id(map: "Orderly_pkey") @default(uuid())
  nhanvien    String   @unique(map: "Orderly_name_key")
  hientrang   String   @default("Đang làm")
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  LAUNDRY
}

enum TicketStatus {
  PENDING
  DELIVERED
}
